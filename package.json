{
  "name": "eyeflow",
  "version": "0.1.1",
  "description": "A low-interruption recovery system for screen-heavy work.",
  "author": "EyeFlow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install:mirror": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm install",
    "build:app": "electron-builder --mac dir --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:dmg": "electron-builder --mac dmg --publish never",
    "build:zip": "electron-builder --mac zip --publish never",
    "install:local": "node scripts/install-local-app.js",
    "refresh:local": "node scripts/refresh-local-app.js",
    "verify": "node scripts/verify.js",
    "capture:current": "node scripts/current-visual-capture.js",
    "smoke:core": "node scripts/smoke-core.js",
    "smoke:session": "node scripts/smoke-session-flow.js",
    "smoke:current-capture": "node scripts/smoke-current-visual-capture.js",
    "smoke:onboarding": "node scripts/smoke-onboarding-flow.js",
    "smoke:retention": "node scripts/smoke-retention-moments.js",
    "smoke:rest": "node scripts/smoke-rest-flow.js",
    "smoke:visual": "node scripts/smoke-visual-utils-test.js",
    "smoke:release": "node scripts/smoke-release-flow.js",
    "smoke:installed": "node scripts/smoke-installed-app.js",
    "smoke:app": "node scripts/smoke-packaged-app.js",
    "release:rc": "node scripts/release-candidate-check.js",
    "release:rc:artifacts": "node scripts/release-candidate-check.js --artifacts",
    "release:public": "node scripts/release-candidate-check.js --artifacts --signed",
    "launch:preflight": "node scripts/launch-preflight.js"
  },
  "private": true,
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.eyeflow.app",
    "productName": "EyeFlow",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "index.html",
      "eyeflow-design-system.css",
      "eyeflow-core.js",
      "eyeflow-recovery-data.js",
      "eyeflow-session-flow.js",
      "eyeflow-rest-flow.js",
      "eyeflow-ui-utils.js",
      "companion.html",
      "break-lock.html",
      "main.js",
      "preload.js",
      "package.json",
      "assets/icon.icns",
      "assets/icon.svg"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        "dir",
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "EyeFlow ${version}",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 140,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
