{
  "name": "eyeflow-next",
  "productName": "EyeFlow",
  "version": "0.2.0",
  "private": true,
  "description": "EyeFlow — a calm menubar companion that watches your eye-use energy (Mira) and invites you to rest.",
  "author": "EyeFlow",
  "license": "UNLICENSED",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "node scripts/verify.mjs",
    "gen:icon": "electron scripts/gen-icon.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "app.eyeflow.next",
    "productName": "EyeFlow",
    "artifactName": "EyeFlow-${version}.${ext}",
    "afterSign": "build/notarize.js",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lovelle-Zhang",
        "repo": "eyeflow"
      }
    ],
    "files": [
      "config/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
